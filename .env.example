# Copia este archivo a .env y ajusta los valores.

# Postgres local de docker-compose.yml
DATABASE_URL="postgresql://openchess:openchess@localhost:5433/openchess?schema=public"

# development, test o production. En producción activa las cookies Secure y exige COOKIE_DOMAIN
NODE_ENV=development

# Puerto de la API (NestJS)
PORT=3333

# URL de la API a la que el front reenvía /api/* (ver apps/web/next.config.js)
API_URL="http://localhost:3333"

# Dominio raíz: <slug>.APP_DOMAIN es el subdominio de cada club
APP_DOMAIN=localhost

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Proxies delante de la API (req.ip y rate limit). Local: 1. Vercel -> Fly: 2
TRUST_PROXY=1

# En producción es obligatorio, p. ej. .openchess.app
# COOKIE_DOMAIN=

# URL pública del front: Lichess vuelve aquí después de vincular la cuenta.
# En producción tiene que ser https:// (con https las cookies de sesión van con Secure)
PUBLIC_URL="http://localhost:3000"

# Emails (verificar la cuenta, recuperar la contraseña) con Resend. Sin clave, en
# desarrollo los emails salen en el log de la API. En producción es obligatoria.
# RESEND_API_KEY=
# EMAIL_FROM="OpenChess <no-reply@openchess.app>"

# Plan Pro con Mercado Pago (suscripción mensual). Sin token, el pago responde 503.
# El webhook se configura en el panel de Mercado Pago (evento de suscripciones) hacia
# <API>/api/billing/mercadopago/webhook; su clave secreta va en MP_WEBHOOK_SECRET.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# PLAN_PRO_PRICE=9990
# PLAN_CURRENCY=CLP
