{
  "name": "@openchess/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "database",
    "tags": [
      "scope:api",
      "type:data"
    ],
    "targets": {
      "generate": {
        "command": "prisma generate",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/prisma/schema.prisma"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ],
        "cache": true
      },
      "migrate": {
        "command": "prisma migrate dev",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "migrate-deploy": {
        "command": "prisma migrate deploy",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test-db": {
        "command": "jest --config jest.db.config.cts --runInBand",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "generate",
          "migrate-deploy"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate"
        ]
      },
      "test": {
        "dependsOn": [
          "generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "generate"
        ]
      }
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  }
}
