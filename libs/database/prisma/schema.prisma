// Esquema de OpenChess.
// Toda tabla con datos de un club lleva club_id y una política RLS (ver migraciones).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // CommonJS: en ESM el cliente usa import.meta.url, webpack lo trata como módulo
  // ESM y se pierde el export ("PrismaClient is not a constructor" al arrancar la API).
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  COACH
  STUDENT

  @@map("member_role")
}

/// Cuenta global: una persona puede ser miembro de varios clubes.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Siempre en minúsculas; la app normaliza antes de guardar.
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  invitationsCreated Invitation[]
  gamesAsWhite       Game[]         @relation("white")
  gamesAsBlack       Game[]         @relation("black")
  ratings            Rating[]
  ratingChanges      RatingChange[] @relation("player")
  rivalRatingChanges RatingChange[] @relation("opponent")

  @@map("users")
}

/// El tenant. Se resuelve por el subdominio: <slug>.openchess.app
model Club {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  invitations Invitation[]
  games       Game[]

  ratings       Rating[]
  ratingChanges RatingChange[]

  @@map("clubs")
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  clubId    String     @map("club_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Link de invitación. Se guarda el SHA-256 del token, nunca el token.
model Invitation {
  id          String     @id @default(uuid()) @db.Uuid
  clubId      String     @map("club_id") @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  role        MemberRole
  createdById String     @map("created_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("invitations")
}

/// Refresh token rotativo. family_id agrupa la cadena de rotaciones:
/// si se reusa un token ya rotado, se revoca la familia entera.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum GameStatus {
  PENDING
  IN_PROGRESS
  FINISHED

  @@map("game_status")
}

/// Partida. El PGN y el reloj alcanzan para reconstruirla (ver libs/games).
model Game {
  id           String     @id @db.Uuid
  clubId       String     @map("club_id") @db.Uuid
  whiteId      String     @map("white_id") @db.Uuid
  blackId      String     @map("black_id") @db.Uuid
  challengerId String     @map("challenger_id") @db.Uuid
  timeKind     String     @map("time_kind")
  initialMs    Int        @map("initial_ms")
  incrementMs  Int        @map("increment_ms")
  pgn          String     @default("")
  /// whiteMs, blackMs, running, since (ver ClockState)
  clock        Json
  drawOfferBy  String?    @map("draw_offer_by")
  status       GameStatus
  result       String?
  termination  String?
  /// Control de concurrencia optimista: sube en cada cambio.
  version      Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  club  Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  white User @relation("white", fields: [whiteId], references: [id], onDelete: Cascade)
  black User @relation("black", fields: [blackId], references: [id], onDelete: Cascade)

  ratingChanges RatingChange[]

  @@index([clubId, status])
  @@index([whiteId])
  @@index([blackId])
  @@map("games")
}

/// Rating Glicko-2 de un jugador en un club (ver libs/ratings). Se crea con su primera partida.
model Rating {
  clubId     String   @map("club_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  rating     Float
  deviation  Float
  volatility Float
  games      Int
  wins       Int
  draws      Int
  losses     Int
  updatedAt  DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([clubId, rating])
  @@map("ratings")
}

/// Cómo cambió el rating de un jugador en una partida. Una fila por jugador:
/// el índice único impide contar dos veces la misma partida.
model RatingChange {
  id           String   @id @default(uuid()) @db.Uuid
  clubId       String   @map("club_id") @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  opponentId   String   @map("opponent_id") @db.Uuid
  score        Float
  ratingBefore Float    @map("rating_before")
  ratingAfter  Float    @map("rating_after")
  createdAt    DateTime @default(now()) @map("created_at")

  club     Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User @relation("player", fields: [userId], references: [id], onDelete: Cascade)
  opponent User @relation("opponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([clubId, userId, createdAt])
  @@map("rating_changes")
}
